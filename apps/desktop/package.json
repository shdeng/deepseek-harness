{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Tauri desktop-shell proof of concept over the shipped DeepSeek Harness Web Host",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "files": [
    "src-tauri/Cargo.lock",
    "src-tauri/Cargo.toml",
    "src-tauri/build.rs",
    "src-tauri/icons",
    "src-tauri/src",
    "src-tauri/tauri.conf.json",
    "static",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml"
  ],
  "scripts": {
    "prepare:host": "pnpm --dir ../.. run build",
    "dev": "pnpm run prepare:host && tauri dev",
    "dev:prepared": "tauri dev",
    "build": "pnpm run prepare:host && tauri build --no-bundle",
    "build:release-host": "node scripts/build-release-host.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "smoke:release-host": "node scripts/smoke-release-host.mjs",
    "release:windows": "pnpm run build:release-host && pnpm run prepare:release && node scripts/smoke-release-host.mjs && tauri build --config src-tauri/tauri.release.conf.json",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
